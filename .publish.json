{
  "strategy": "script-archive",
  "metadata": {
    "path": "lib/metadata.sh",
    "version": "GILLII_VERSION",
    "date": "GILLII_DATE",
    "repository": "GILLII_REPOSITORY"
  },
  "files": [
    "bin",
    "lib",
    "libexec",
    "completions",
    "man",
    "LICENSE",
    "THIRD-PARTY.md",
    "install.sh"
  ],
  "exclude": [
    "*.test.mjs"
  ],
  "npm": [
    "libexec/tools/wxappUnpacker"
  ],
  "checks": [
    [
      "bash",
      "tests/test.sh"
    ]
  ],
  "archive_checks": [
    [
      "node",
      "--test",
      "libexec/*.test.mjs"
    ]
  ]
}
